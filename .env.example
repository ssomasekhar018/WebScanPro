# ─────────────────────────────────────────────────────────────────────────────
# WebScan Pro — Environment Variables Template
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── HuggingFace API Token ─────────────────────────────────────────────────────
# Required for RAG pipeline (google/flan-t5-large inference).
# Get yours at: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=hf_your_token_here

# ── Optional: Override default DVWA target URL ────────────────────────────────
DVWA_BASE_URL=http://localhost/dvwa

# ── Optional: Streamlit port override ────────────────────────────────────────
# STREAMLIT_SERVER_PORT=8501
